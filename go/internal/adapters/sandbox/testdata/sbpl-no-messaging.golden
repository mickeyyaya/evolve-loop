(version 1)
(deny default)
(import "system.sb")
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)
(allow file-read-metadata)
(allow file-read* (subpath "/nonexistent/repo"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/opt"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/var"))
(allow file-read* (subpath "/private/var"))
(allow file-read* (require-all (subpath "/dev") (require-not (regex #"^/dev/(tty|pty)[^/]+$"))))
(allow file-read* (subpath "/nonexistent/home"))
(allow file-read* (subpath "/tmp"))
(allow file-write* (subpath "/tmp"))
(allow file-read* (subpath "/private/tmp"))
(allow file-write* (subpath "/private/tmp"))
(allow file-read* (subpath "/var/folders"))
(allow file-write* (subpath "/var/folders"))
(allow file-read* (subpath "/private/var/folders"))
(allow file-write* (subpath "/private/var/folders"))
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write-data file-ioctl (require-all (regex #"^/dev/ttys[0-9]+$") (extension "com.apple.sandbox.pty")))
(allow file-read* file-write-data (literal "/dev/tty") (literal "/dev/ttys042"))
(allow file-ioctl (require-all (require-any (literal "/dev/tty") (literal "/dev/ttys042")) (require-any (ioctl-command TIOCGETA) (ioctl-command TIOCSETA) (ioctl-command TIOCSETAW) (ioctl-command TIOCSETAF) (ioctl-command TIOCGWINSZ))))
(allow file-write* (subpath "/nonexistent/home/.claude"))
(allow file-write* (subpath "/nonexistent/home/.codex"))
(allow file-write* (subpath "/nonexistent/home/.gemini"))
(allow file-write* (subpath "/nonexistent/home/.cache"))
(allow file-write* (subpath "/nonexistent/home/.config"))
(allow file-write* (subpath "/nonexistent/home/Library/Caches"))
(allow file-write* (subpath "/nonexistent/home/Library/Application Support"))
(deny file-write* (subpath "/nonexistent/repo"))
(allow file-write* (subpath "/nonexistent/repo/wt"))
(allow file-write* (subpath "/nonexistent/ws"))
(allow file-write* (subpath "/tmp"))
(deny file-write* (subpath "/nonexistent/deny"))
(deny file-write* (subpath "/nonexistent/denywrite"))
(deny file-read-data (subpath "/nonexistent/repo/.evolve/runs") (with message "evolve-cell=t1 rule=read.runs.unrelated inv=I5"))
(deny file-read-data (subpath "/nonexistent/secrets") (with message "evolve-cell=t1 rule=read.home.secret inv=I5"))
(deny file-write* (subpath "/nonexistent/secrets") (with message "evolve-cell=t1 rule=read.home.secret inv=I5"))
(allow file-read* file-read-data (subpath "/nonexistent/ws"))
(deny file-read-data (subpath "/nonexistent/raw") (with message "evolve-cell=t1 rule=read.raw.output inv=I4"))
(deny file-write* (subpath "/nonexistent/raw") (with message "evolve-cell=t1 rule=write.raw.output inv=I4"))
(deny file-write* (subpath "/nonexistent/ws/inputs") (with message "evolve-cell=t1 rule=write.inputs inv=I4"))
(deny file-write* (literal "/nonexistent/pin") (with message "evolve-cell=t1 rule=write.pipeline.file inv=I5"))
(deny file-read* (subpath "/nonexistent/denyread"))
(deny file-read* (literal "/nonexistent/mask"))
(deny file-write* (literal "/nonexistent/ro"))
(deny file-write* (literal "/nonexistent/lit"))
(allow network*)
(deny network-outbound (remote unix-socket (path-literal "/nonexistent/sock")))
(deny process-exec (require-all (literal "/nonexistent/bin/x") (require-not (signing-identifier "com.apple.sandbox-exec"))))
(deny process-exec (require-all (literal "/usr/bin/sandbox-exec") (require-not (signing-identifier "com.apple.sandbox-exec"))))
(deny process-exec (require-all (subpath "/nonexistent/binroot") (require-not (signing-identifier "com.apple.sandbox-exec"))))
(deny file-write* (subpath "/nonexistent/repo/.evolve/events"))
(deny file-write* (prefix "/nonexistent/repo/.evolve/state"))
