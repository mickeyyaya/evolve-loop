{
  "Stage": 2,
  "Mode": 0,
  "ModelRouting": 2,
  "CommitEvidence": 0,
  "ReviewGate": 0,
  "EvalGate": 3,
  "ContractGate": 3,
  "TriageCapGate": 3,
  "TopNGate": 3,
  "SandboxMode": "auto",
  "PhaseRecovery": 1,
  "SpineFloor": 3,
  "FatalPane": 3,
  "PhaseIO": 3,
  "RouterReplan": 1,
  "MergeGate": 1,
  "ParallelEvaluate": 0,
  "ScoutDecompose": 0,
  "Mandatory": [
    "scout",
    "triage",
    "build",
    "audit",
    "ship"
  ],
  "Conditional": {
    "build-planner": {
      "Field": "triage.unified_size",
      "Op": "!=",
      "Value": "",
      "And": null
    },
    "plan-review": {
      "Field": "triage.unified_size",
      "Op": "!=",
      "Value": "",
      "And": null
    },
    "tdd": {
      "Field": "cycle_size",
      "Op": "!=",
      "Value": "trivial",
      "And": [
        {
          "Field": "deliverable_kind",
          "Op": "!=",
          "Value": "document",
          "And": null
        }
      ]
    }
  },
  "DeliverableKinds": {
    "document": {
      "root": "solutions",
      "min_options": 2,
      "required_files": [
        "recommendation.md",
        "assumptions-and-evidence.md"
      ],
      "required_sections": {
        "assumptions-and-evidence.md": [
          "Assumptions",
          "Evidence"
        ],
        "recommendation.md": [
          "Options Compared",
          "Recommendation"
        ]
      },
      "forbid_placeholders": [
        "TBD",
        "TODO",
        "lorem ipsum"
      ],
      "evidence_file": "assumptions-and-evidence.md"
    }
  },
  "MaxInsertions": 6,
  "ParallelEvaluateConcurrency": 3,
  "ScoutDecomposeConcurrency": 4,
  "PhaseEnable": {
    "architecture-design": 0,
    "build-planner": 2,
    "swarm-plan": 2,
    "tdd": 1,
    "tester": 0,
    "triage": 1
  },
  "Triggers": {
    "architecture-design": {
      "insert_when": [
        {
          "field": "scout.cycle_size",
          "op": "==",
          "value": "large"
        }
      ],
      "skip_when": null,
      "rubric_hint": [
        "a novel/cross-cutting goal also warrants architecture-design (a design pass before tdd/build)"
      ]
    },
    "plan-review": {
      "insert_when": null,
      "skip_when": null,
      "rubric_hint": [
        "build.files_touched \u003e= 10 OR build.diff_loc \u003e= 500 → insert plan-review"
      ]
    },
    "retrospective": {
      "insert_when": null,
      "skip_when": null,
      "rubric_hint": [
        "audit.verdict == FAIL OR audit.confidence \u003c 0.85 → insert retrospective"
      ]
    },
    "scout": {
      "insert_when": null,
      "skip_when": null,
      "rubric_hint": [
        "scout.carryover_count \u003e= 3 → skip scout (work already queued)",
        "scout.item_count == 0 → end cycle early (no-ship is legitimate)"
      ]
    },
    "tester": {
      "insert_when": [
        {
          "field": "build.acs_red",
          "op": "gt",
          "value": 0
        },
        {
          "field": "build.severity_max",
          "op": "gte",
          "value": "HIGH"
        }
      ],
      "skip_when": null
    }
  },
  "Order": [
    "intent",
    "scout",
    "triage",
    "spec-verify",
    "architecture-design",
    "plan-review",
    "tdd",
    "build-planner",
    "build",
