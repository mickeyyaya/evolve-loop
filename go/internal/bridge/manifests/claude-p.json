{
  "schema_version": 1,
  "cli": "claude-p",
  "binary": "claude",
  "env_passthrough": ["CLAUDE_CONFIG_DIR", "HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY", "NODE_EXTRA_CA_CERTS"],
  "model_family": "claude",
  "binary_min_version": "2.1.0",
  "transport": "headless",
  "default_tier": "full",
  "tier_dependencies": {
    "full": ["claude"]
  },
  "prompt_marker": null,
  "default_model": "haiku",
  "default_args": ["--strict-mcp-config"],
  "params": {
    "effort": {
      "channel": "flag",
      "flag": "--effort"
    },
    "disallowed_tools": {
      "channel": "flag",
      "flag": "--disallowedTools"
    }
  },
  "interactive_prompts": []
}
