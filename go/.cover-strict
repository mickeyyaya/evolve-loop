# Strict line-coverage gate (ADR-0101 decision 9; design §11). One line per
# package: `<go list pattern> <minimum statement coverage %>`. `make cover-strict`
# and the go.yml step "line-coverage strict" read this file, so the two surfaces
# cannot drift. Packages listed here ship with the coverage they declare; a
# regression fails the tree. Blank lines and `#` comments are ignored.
./internal/signalcenter 100
./internal/core/outcome 100
./internal/deliverable/gatesignal 100
./internal/core/failurediag 100
./internal/core/carryover 100
./internal/core/failurelearning 100
./internal/phases/ship/landing 100
./internal/config 100
./internal/observerengine 100
./internal/core/defectledger 100
./internal/inboxmover/lifecycle 100
./internal/bridge/launchoutcome 100
./internal/phases/runner/verdict 100
