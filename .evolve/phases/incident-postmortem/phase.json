{
  "name": "incident-postmortem",
  "kind": "llm",
  "archetype": "evaluate",
  "optional": true,
  "description": "Structured 4-section debrief to prevent incident recurrence when root causes go unrecorded.",
  "when_to_use": "When an incident recurs because the root cause was previously unrecorded.",
  "categories": [
    "bugfix",
    "security"
  ],
  "inputs": {},
  "outputs": {
    "files": [
      ".evolve/runs/cycle-{cycle}/incident-postmortem-report.md"
    ]
  },
  "classify": {
    "require_sections": [
      "Incident Summary",
      "Root Cause Analysis",
      "Remediation Steps",
      "Prevention Plan"
    ],
    "verdict_on_pass": "PASS",
    "require_failure_context": true
  },
  "routing": {
    "insert_when": [],
    "skip_when": null
  },
  "gates": {},
  "after": "build"
}