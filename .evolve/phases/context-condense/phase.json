{
  "name": "context-condense",
  "archetype": "control",
  "agent": "evolve-context-condense",
  "description": "Condense workspace reports when artifacts exceed replay threshold (run_dirs=133, p95=45248, max=74833, threshold=51200).",
  "inputs": {
    "files": [
      ".evolve/runs/cycle-{cycle}/scout-report.md"
    ],
    "signals": [
      "run_dir.artifact_bytes"
    ]
  },
  "outputs": {
    "files": [
      ".evolve/runs/cycle-{cycle}/context-condense-report.md"
    ],
    "signals": [
      "condense.ratio"
    ]
  },
  "classify": {
    "require_sections": [
      "Artifacts Scanned",
      "Condensed Digest",
      "Verdict"
    ]
  },
  "routing": {
    "insert_when": [
      {
        "field": "run_dir.artifact_bytes",
        "op": "gt",
        "value": 51200
      }
    ]
  },
  "after": "triage",
  "optional": true
}
