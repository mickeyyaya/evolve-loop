{
  "acs": {
    "go_timeout_s": 600,
    "predicate_env": [
      "EVOLVE_FLAG_CAMPAIGN"
    ]
  },
  "catalog": {
    "auto_refresh": false,
    "refresh_stage": "shadow",
    "allowed_families": {
      "agy": [
        "gemini"
      ],
      "claude": [
        "claude"
      ],
      "codex": [
        "gpt"
      ]
    }
  },
  "cli_health": {
    "proactive_probe": true
  },
  "description": "Evolve loop operator policy (ADR-0055 D3 floor gates + operator config: catalog refresh, ACS lane timeout and the operator keys forwarded to predicates, parallel-evaluate rollout, per-phase CLI/model pins, gc retention horizons, the inbox priority rank's class order and factor weights).",
  "disposition": {
    "stage": "enforce"
  },
  "failure_disposition": {
    "stage": "enforce"
  },
  "fleet": {
    "count": 3,
    "plan_source": "triage",
    "min_lanes": 2
  },
  "floor": [
    {
      "id": "dossier-closeout",
      "description": "Every completed cycle must write a dossier to knowledge-base/cycles/cycle-N.json. Enforced by evolve dossier verify.",
      "enforced_since_cycle": 2
    }
  ],
  "gc": {
    "go_cache_ttl_hours": 24,
    "mode": "enforce",
    "runs": {
      "delete_after_days": 14
    },
    "temp_ttl_hours": 24,
    "worktrees": {
      "salvage_after_hours": 24
    }
  },
  "inbox_priority": {
    "class_order": [
      "correctness",
      "stability",
      "performance",
      "debuggability",
      "feature",
      "maintainability",
      "hygiene",
      "security"
    ],
    "factors": {
      "base": 0.45,
      "class": 0.2,
      "unblocks": 0.15,
      "recurrence": 0.1,
      "age": 0.05,
      "goal": 0.05
    },
    "age_halflife_days": 30,
    "unblocks_cap": 3,
    "recurrence_cap": 5,
    "active_campaigns": [],
    "preempt_margin": 0.05
  },
  "parallel_evaluate": {
    "stage": "shadow",
    "concurrency": 3
  },
  "version": 1,
  "workflow": {
    "universal_fallback_exclude": []
  }
}
