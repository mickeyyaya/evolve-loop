{
  "acs": {
    "go_timeout_s": 600,
    "predicate_env": [
      "EVOLVE_FLAG_CAMPAIGN"
    ]
  },
  "catalog": {
    "auto_refresh": false,
    "refresh_stage": "shadow",
    "allowed_families": {
      "agy": [
        "gemini"
      ],
      "claude": [
        "claude"
      ],
      "codex": [
        "gpt"
      ]
    }
  },
  "cli_health": {
    "proactive_probe": true
  },
  "description": "Evolve loop operator policy (ADR-0055 D3 floor gates + operator config: catalog refresh, ACS lane timeout and the operator keys forwarded to predicates, parallel-evaluate rollout, per-phase CLI/model pins, gc retention horizons).",
  "disposition": {
    "stage": "enforce"
  },
  "failure_disposition": {
    "stage": "enforce"
  },
  "fleet": {
    "count": 3,
    "plan_source": "triage",
    "min_lanes": 2
  },
  "floor": [
    {
      "id": "dossier-closeout",
      "description": "Every completed cycle must write a dossier to knowledge-base/cycles/cycle-N.json. Enforced by evolve dossier verify.",
      "enforced_since_cycle": 2
    }
  ],
  "gc": {
    "go_cache_ttl_hours": 24,
    "runs": {
      "delete_after_days": 14
    },
    "temp_ttl_hours": 24,
    "worktrees": {
      "salvage_after_hours": 24
    }
  },
  "parallel_evaluate": {
    "stage": "shadow",
    "concurrency": 3
  },
  "version": 1
}
