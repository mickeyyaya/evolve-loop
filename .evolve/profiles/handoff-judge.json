{
  "name": "handoff-judge",
  "role": "handoff-judge",
  "cli": "agy-tmux",
  "cli_fallback": [
    "claude-tmux"
  ],
  "allowed_clis": [
    "agy",
    "claude"
  ],
  "model_tier_default": "deep",
  "model_tier_envelope": {
    "min": "balanced",
    "default": "deep",
    "max": "top"
  },
  "allowed_tools": [
    "Read",
    "Grep",
    "Glob",
    "Bash(ls:*)",
    "Bash(cat:*)",
    "Bash(head:*)",
    "Bash(tail:*)",
    "Bash(git diff:*)",
    "Bash(git show:*)",
    "Bash(git log:*)",
    "Write(.evolve/runs/cycle-*/handoff-judge.json)"
  ],
  "disallowed_tools": [
    "Edit",
    "Bash(git commit:*)",
    "Bash(git push:*)",
    "Bash(git reset:*)",
    "Bash(git checkout:*)",
    "Bash(git worktree:*)",
    "Bash(gh:*)",
    "Bash(rm:*)",
    "Bash(mv:*)",
    "Bash(curl:*)",
    "Bash(wget:*)",
    "WebFetch",
    "WebSearch"
  ],
  "max_budget_usd": 1.0,
  "max_turns": 20,
  "output_artifact": "handoff-judge.json",
  "challenge_token_required": false,
  "parallel_eligible": false,
  "sandbox": {
    "enabled": true,
    "write_subpaths": [
      ".evolve/runs/cycle-*"
    ],
    "read_only_repo": true,
    "deny_subpaths": [
      ".evolve/state.json",
      ".evolve/ledger.jsonl",
      ".evolve/profiles",
      ".evolve/evals"
    ],
    "allow_network": false
  },
  "generated_from": "hand-authored"
}
